# Copy to .env (never commit .env).
POSTGRES_PASSWORD=change-me-long-random
# python -c "import secrets; print(secrets.token_urlsafe(48))"
EUAIACT_SECRET_KEY=change-me-at-least-32-random-characters
EUAIACT_BASE_URL=https://ai-literacy.example.eu

# E-mail for reminders and learning links (optional; without it reminders stay queued in the app).
EUAIACT_SMTP_HOST=smtp.example.eu
EUAIACT_SMTP_PORT=587
EUAIACT_SMTP_SECURITY=starttls
EUAIACT_SMTP_USERNAME=
EUAIACT_SMTP_PASSWORD=
EUAIACT_SMTP_FROM=AI Literacy <ai-literacy@example.eu>
